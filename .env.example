# Copy to .env.local and fill in. Never commit .env.local.

# --- Neon (Postgres) ---
# Main branch: real calls. Test branch: simulated calls from the eval suite.
DATABASE_URL=
DATABASE_URL_TEST=

# --- Vaani Labs (voice agent) ---
VAANI_API_KEY=
# Webhook signing secret (vv_whk_…), shown once when you register the webhook in Vaani's dashboard
VAANI_WEBHOOK_SECRET=
# Random string; the Vaani flow sends it as x-aangan-tool-secret when calling our live tools
VAANI_TOOL_SECRET=
# Your Vaani per-minute rate (₹) from the dashboard, for cost tracking
VAANI_INR_PER_MINUTE=

# --- Gemini Flash (post-call extraction + classification) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Booking: "calcom" (one free Cal.com account; consultant assigned by us) or "gcal" ---
BOOKING_PROVIDER=calcom
CALCOM_API_KEY=
# Numeric id of the "Free design consultation" event type (from its URL, or: npm run calcom:event-types)
CALCOM_EVENT_TYPE_ID=

# --- Google Calendar (only if BOOKING_PROVIDER=gcal) ---
# Service account key JSON (raw or base64). Each designer shares their calendar with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: consultation hours (IST). Defaults: Mon–Sat, 10:00–19:00, 60-min slots, earliest 20h from now
CONSULT_DAYS=
CONSULT_START_HOUR=
CONSULT_END_HOUR=

# --- Telegram (designer handoff) ---
TELEGRAM_BOT_TOKEN=
# Random string; Telegram sends it back on every webhook so we can verify it
TELEGRAM_WEBHOOK_SECRET=
# Chat that receives escalations (front desk / Nikhil)
TELEGRAM_ESCALATION_CHAT_ID=

# --- HubSpot (connected last; deals queue in Neon until then) ---
# Private app token (Settings → Integrations → Private apps), scopes: crm.objects.contacts/deals read+write, crm.schemas read+write
HUBSPOT_ACCESS_TOKEN=
# Optional: pipeline id and our-stage → HubSpot-stage-id map, if HubSpot's setup doesn't use the defaults
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_MAP=

# --- App ---
APP_BASE_URL=http://localhost:3000
# Login for Nikhil's dashboard
DASHBOARD_PASSWORD=
# Random string; the GitHub Actions sweeper sends it to /api/cron/sweep
CRON_SECRET=
